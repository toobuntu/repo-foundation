# Bundler install path: third-party gems, neither committed nor first-party.
# Listed here so reuse/annotate never assert repo-foundation's copyright over
# upstream code.
/vendor/

# macOS directory metadata
.DS_Store

# Agent session continuity (ADR 0022): volatile per-developer state.
# .ai/memory.md, .ai/org/memory.md, and .ai/progress.template.md are
# committed; these are not. .ai/org/relay.md is deliberately NOT ignored
# (2026-07-26 amendment): it carries org knowledge in transit, and ignoring
# it stranded that knowledge on whichever machine wrote it.
.ai/progress.md
.ai/scratchpad/
# scripts/ai/ai-session.sh bookkeeping: the session-start snapshot of
# progress.md, the clean-close and close-check markers, and relays retired
# after promotion (kept for a grace period, never the record — see the
# script's header).
.ai/.progress.session-start*
.ai/.session-closed
.ai/.close-check-state
.ai/.last-compact
.ai/.compact-check-state
.ai/org/relay.consumed-*.md

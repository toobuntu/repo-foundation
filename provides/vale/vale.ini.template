# Vale prose linter. The canonical org-wide Toobuntu style and its accept
# vocabulary under .vale/styles/ sync from repo-foundation (ADR 0014); this
# .vale.ini is per-repo because the scope-block relaxations vary. foundation-init
# copies this scaffold to .vale.ini (the .template infix is stripped) — then edit
# the relaxations for this repo.
#
# Only error-level alerts gate CI under MinAlertLevel = error. A new rule lands
# at warning, runs over the corpus, and is promoted to error after a clean pass
# (ADR 0014). Toobuntu.AmericanSpelling (en_US dialect) runs everywhere — it is
# correctness, not voice. Vale.Spelling rides at warning until the repo's accept
# vocabulary covers its domain terms; promotion is this repository's own call,
# taken against its own corpus, because this file is not synced.
#
# Two vocabularies, and the order does not matter: Toobuntu is the canonical
# org-wide list, synced read-only from repo-foundation; Local is this
# repository's own, never synced, and the right home for its domain terms — a
# product name, a daemon, a flag. Add to Local first and reach for the
# canonical list only when a term is genuinely org-wide.
#
# Do not delete the Local entry without also deleting its directory, and do not
# name a vocabulary that does not exist: vale treats that as a runtime error
# (E100) and lints NOTHING, so the prose gate fails with a config error rather
# than a finding. foundation-init seeds .vale/styles/config/vocabularies/Local/
# with an empty accept.txt and its .license sidecar for exactly this reason —
# git does not track an empty directory, so the file has to be real.
#
# Install: brew install vale
StylesPath = .vale/styles
MinAlertLevel = error
Vocab = Toobuntu, Local

[*.md]
BasedOnStyles = Vale, Toobuntu
Vale.Terms = NO
Vale.Spelling = warning

[docs/handoff/*.md]
# Working notes / session handoffs: impersonal voice and the dictionary speller
# are off; dialect (Toobuntu.AmericanSpelling) stays on. Add repo-specific
# relaxations below, e.g. a design doc dense with snippets:
#   [docs/design/*.md]
#   Vale.Spelling = NO
Vale.Spelling = NO
Toobuntu.We = NO

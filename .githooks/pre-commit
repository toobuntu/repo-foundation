# Canonical pre-commit hook -- repo-agnostic runner (repo-foundation lineage).
# Install: git config core.hooksPath .githooks
#
# This file runs no checks of its own. It blocks commits to main, computes the
# staged-file list once, and runs the drop-in plugins in .githooks/pre-commit.d/
# -- so the base can be synced verbatim to every consumer while each repo's
# checks stay in plugins. Org-wide checks are plugins too (80-perms,
# 80-unicode, 80-workflows, 85-reuse); they are canonical and travel with this
# file.
#
# Debugging: PRE_COMMIT_VERBOSE=1 announces each stage with a timestamp on
# stderr (which check is running, which plugin), so a slow or hanging commit
# shows where it stopped. PRE_COMMIT_TRACE=1 additionally turns on `set -x`
# for a full execution trace. Both are read from the environment:
#   PRE_COMMIT_VERBOSE=1 git commit …
#   PRE_COMMIT_TRACE=1 git commit …

set -e

[ -n "${PRE_COMMIT_TRACE:-}" ] && set -x
say() {
  [ -n "${PRE_COMMIT_VERBOSE:-}${PRE_COMMIT_TRACE:-}" ] || return 0
  printf 'pre-commit %s: %s\n' "$(date '+%H:%M:%S')" "$*" >&2
}

# Portability (for reviewers): the runner and its plugins use two BSD/macOS
# options that some linters still flag as "GNU-only." Both are in the macOS
# base system on every supported release, so do not "port them away":
#   grep -z / --null-data : apple-oss-distributions/grep commit da7a17f
#     (grep-6.1, 2021-10-06); man-page-documented since macOS 12 Monterey.
#   xargs -r              : apple-oss-distributions/shell_cmds commit eb0d59c
#     (shell_cmds-216.40.4, 2021-10-06) -> macOS 11.0.1 Big Sur.
#   xargs --no-run-if-empty (the long form of -r): shell_cmds commit e256b9a
#     (shell_cmds-302.0.1, 2023-09-22)  -> macOS 14.0 Sonoma.
# Refs: github.com/apple-oss-distributions/{grep,shell_cmds},
# opensource.apple.com/releases, https://man.freebsd.org/ (macOS selected).

# Block direct commits to main.
branch=$(git branch --show-current)
if [ "$branch" = "main" ]; then
  printf 'error: direct commits to main are not allowed. Create a feature branch.\n' >&2
  exit 1
fi

# --- The staged-file list, computed once ---
# Plugins run in a subprocess and so cannot share a shell function; without
# this each would re-derive the same list, costing a `git diff` per plugin.
# The runner writes the list to a temp file and exports its path as
# PRE_COMMIT_STAGED_LIST. A plugin greps its own pattern out of that file
# (grep --null-data) and pipes into `xargs -0`.
#
# NUL-delimited, so a path containing whitespace or a newline survives intact.
#
# Diff filter ACMRT (Added, Copied, Modified, Renamed, Type-changed) — the
# same set scripts/lint-perms.sh uses. Renames matter to the content checks,
# not only to the perms check: git reports a rename carrying a moderate edit
# (>=50% similarity) as R, not M, so a plain ACM filter would skip a
# renamed-and-edited file and let the edit — a bidi character, a formatting
# break, a stripped SPDX header — past the hook at its new path. Including R
# re-checks it there. The only cost is re-checking the occasional pure
# (content-identical) rename, which is cheap and always passes. D (deleted)
# and U (unmerged) are excluded: no present blob to check.
#
# The list is a snapshot of the staged PATH SET taken before any plugin runs.
# That is sound because a plugin only ever re-stages paths already in the set
# (the formatters in the 10- tier rewrite staged files in place), so the set
# does not change during the run — only the content behind it does, and the
# plugins that read content read it when they run. A plugin that stages a
# path that was not already staged would not be seen by later plugins; none
# does, and none should.
PRE_COMMIT_STAGED_LIST=$(mktemp "${TMPDIR:-/tmp}/pre-commit-staged.XXXXXX")
export PRE_COMMIT_STAGED_LIST
trap 'rm -f "$PRE_COMMIT_STAGED_LIST"' EXIT INT TERM
say "collecting staged files"
git diff --cached --name-only --diff-filter=ACMRT -z > "$PRE_COMMIT_STAGED_LIST"

# --- Plugins ---
# Drop-in scripts in .githooks/pre-commit.d/, run here (each in a subprocess)
# in sorted order -- the Unix /etc/cron.d convention. Prefix names with a
# 2-digit number for ordering. Names follow Debian run-parts' default rule:
# entirely [A-Za-z0-9_-] (no dot, no extension); a name with a dot is skipped,
# so a dot suffix (20-go.off, *.disabled, *.sample) disables a plugin.
# scripts/lint-perms.sh enforces the execute bit on the same name set.
#
# The number is the tier: 10- format checks, 20- language toolchains, 50-
# repo tooling, 80- the org-wide verifiers, 85- REUSE. The verifiers run last
# because they must see whatever the earlier tiers restaged.
if [ -d .githooks/pre-commit.d ]; then
  for hook in .githooks/pre-commit.d/*; do
    [ -f "$hook" ] || continue
    # run-parts classicalre: run only names matching ^[A-Za-z0-9_-]+$.
    # grep, not a `case` glob: the POSIX negated bracket [!...] is broken
    # in macOS /bin/sh (bash 3.2 matches it against everything), and the
    # [^...] form is not portable to dash. grep -E under LC_ALL=C is the
    # same regex run-parts compiles and behaves identically everywhere.
    printf '%s\n' "${hook##*/}" |
      LC_ALL=C /usr/bin/grep --extended-regexp --quiet '^[A-Za-z0-9_-]+$' ||
      continue
    [ -x "$hook" ] || continue
    say "plugin ${hook##*/}"
    "$hook" || exit $?
  done
fi
